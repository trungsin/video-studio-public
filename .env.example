# ===== Đăng nhập =====
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài để ký cookie phiên (openssl rand -hex 32)
SESSION_SECRET=
# Secret cho cron gọi POST /api/publish/run (header Authorization: Bearer ...)
CRON_SECRET=

# ===== Thư mục dữ liệu =====
DATA_DIR=./data
MEDIA_DIR=./media
# Múi giờ của khung đăng (Việt Nam không có DST)
TZ_OFFSET=+07:00

# ===== LLM (OpenAI-compatible: OpenAI, xAI, OpenRouter, CLIProxyAPI, Ollama...) =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Profile biên tập: chỉ gợi ý trang nguồn, không tự duyệt trích dẫn. Thiếu key vẫn nhập nguồn thủ công.
BRAVE_SEARCH_API_KEY=
# 1 bật worker tương ứng trong Docker; cả hai mặc định tắt. Lịch còn cần bật riêng trong giao diện.
EDITORIAL_PRODUCTION_ENABLED=0
EDITORIAL_SCHEDULE_ENABLED=0

# ===== Ảnh AI cho cảnh (tuỳ chọn) =====
# IMAGE_PROVIDER: openai | xai | hf-kontext | gemini | quanlop | none | <ID provider tự thêm>  (profile có thể ghi đè: "imageProvider" trên /profile)
# Provider thêm trên trang /provider (VD CLIProxyAPI): cấu hình ở data/image-providers.json, khoá do giao diện ghi vào
# file env này thành IMAGE_PROVIDER_KEY__<ID> (VD IMAGE_PROVIDER_KEY__CLIPROXY_GPT). Không cần đặt tay.
#   openai     : OpenAI-compatible; có ảnh ref -> /images/edits (multipart image[]), không ref -> /images/generations
#   xai        : Grok Imagine (/v1/images/edits, tối đa 5 ảnh ref) - dùng XAI_API_KEY
#   hf-kontext : FLUX.1-Kontext-Dev trên Hugging Face (miễn phí, giới hạn lượt; HF_TOKEN để thêm quota), 1 ảnh ref
#   gemini     : Google Gemini API (generateContent, responseModalities IMAGE), tối đa 4 ảnh ref inline - dùng GEMINI_API_KEY;
#                IMAGE_MODEL mặc định gemini-3.1-flash-image, IMAGE_ASPECT mặc định 9:16 (hoặc 'aspect' trong video/cảnh)
IMAGE_PROVIDER=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1536
XAI_API_KEY=
HF_TOKEN=
GEMINI_API_KEY=
IMAGE_ASPECT=9:16

# ===== Image-to-video cho cảnh (tuỳ chọn) =====
# VIDEO_PROVIDER: xai | veo | none   (không đặt -> Ken Burns trên ảnh tĩnh). MẶC ĐỊNH TẮT.
#   veo: TUỲ CHỌN, TRẢ PHÍ - Google Veo qua Gemini API (GEMINI_API_KEY, cần billing). VIDEO_MODEL=veo-3.1-fast-generate-preview
#        (~$0.10/s 720p) hoặc veo-3.1-lite-generate-preview (~$0.05/s); clip 4/6/8 s. Giá theo ai.google.dev/gemini-api/docs/pricing (10/2026).
#   Clip tự làm/tải lên: đặt scene.clip = assets/... (không cần provider).
VIDEO_PROVIDER=
VIDEO_MODEL=grok-imagine-video

# ===== TTS =====
# edge-tts dùng mặc định, không cần key. VieNeu (Gradio) tuỳ chọn:
VIENEU_GRADIO_URL=
PYTHON_BIN=python3

# ===== myCDN (ảnh/video phục vụ) =====
# Profile có key: worker cdn-sync đẩy ảnh cảnh, ảnh tư liệu, MP4 đã render, data/assets/<slug> lên CDN;
# /api/media, /api/assets, /api/thumb chuyển hướng 302 sang CDN. Không có key: phục vụ local như cũ.
# MYCDN_URL=https://cdn.example.com
# MYCDN_API_KEY__<SLUG>=          # VD MYCDN_API_KEY__BEP_NHA_MAY cho slug bep-nha-may

# ===== Đăng bài =====
# 1 = giả lập đăng: chạy adapter thật với fetch mô phỏng, in request (token đã che), không gọi mạng
PUBLISH_DRY_RUN=1
# Khai báo nội dung AI (mặc định bật): cờ AI của từng nền tảng + dòng này thêm vào caption
AI_DISCLOSURE=1
AI_DISCLOSURE_TEXT=Nội dung minh họa có sử dụng AI.
# Zernio (https://docs.zernio.com) - một key cho mọi nền tảng đã kết nối
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
# account ID không đặt ở đây: bấm "Tải lại" ở Profile & kênh để đồng bộ từ Zernio
# ZERNIO_POLL_INTERVAL_MS=10000
# ZERNIO_POLL_TIMEOUT_MS=600000
# ZERNIO_TIKTOK_DRYRUN=1
# Facebook Page Reels (Graph API video_reels). Page token có pages_show_list, pages_read_engagement, pages_manage_posts
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v26.0
# FB_REELS_STATE=PUBLISHED
# FB_UPLOAD_RETRIES=3
# FB_POLL_INTERVAL_MS=5000
# FB_POLL_TIMEOUT_MS=600000
# Instagram Reels trực tiếp (upload resumable, không cần URL công khai).
# IG_USER_ID = id tài khoản IG Business/Creator (GET /{page-id}?fields=instagram_business_account)
# IG_ACCESS_TOKEN = token Facebook Login for Business có instagram_basic, instagram_content_publish, pages_read_engagement
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v26.0
# IG_GRAPH_HOST=graph.facebook.com
# IG_SHARE_TO_FEED=1
# IG_POLL_INTERVAL_MS=30000
# IG_POLL_TIMEOUT_MS=600000
# YouTube Data API v3.
# Cách 1 (khuyên dùng, không cần HTTPS): client OAuth loại "Desktop app". Không cần đăng ký redirect URI;
#   app dùng loopback http://127.0.0.1:8765/ (đổi bằng YT_LOOPBACK_REDIRECT). Sau khi đồng ý, copy URL trang lỗi
#   127.0.0.1 dán vào ô ở Profile & kênh (/profile) -> app tự đổi lấy refresh token (PKCE).
YT_DESKTOP_CLIENT_ID=
YT_DESKTOP_CLIENT_SECRET=
# YT_LOOPBACK_REDIRECT=http://127.0.0.1:8765/
# App OAuth ở chế độ Testing: Google thu hồi refresh token sau 7 ngày. Đặt 0 khi app đã publish "In production".
YT_OAUTH_TESTING=0
# YT_TOKEN_CLIENT, YT_TOKEN_ISSUED_AT, YT_PROFILE (profile sở hữu), YT_CHANNEL_ID do app tự ghi cùng YT_REFRESH_TOKEN.
# Cách 2 (cần HTTPS): client OAuth loại "Web application".
# YT_REFRESH_TOKEN do nút "Kết nối YouTube" (Profile & kênh) tự ghi vào .env, không cần dán tay.
# Google chỉ nhận redirect https hoặc localhost -> mở app qua tailscale serve HTTPS:
#   tailscale serve --bg --https=443 http://127.0.0.1:3100   (cần bật HTTPS Certificates trong Tailscale admin > DNS)
# Đăng ký đúng URI này ở Google Cloud > Clients > Authorized redirect URIs:
YT_REDIRECT_URI=https://video-studio-box.<tailnet>.ts.net/api/youtube/oauth/callback
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private
# YT_CATEGORY_ID=27
# YT_LANGUAGE=vi
# TikTok Content Posting API (access token của user, scope video.publish)
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# Chủ kết nối API trực tiếp (token .env dùng chung): chỉ profile này được đăng qua FB/IG/YT/TikTok trực tiếp.
# Riêng từng nền tảng: FB_PROFILE, IG_PROFILE, YT_PROFILE, TIKTOK_PROFILE. Profile "sample": true không bao giờ đăng thật.
DIRECT_PROFILE=
# Instagram Reels trực tiếp: IG_ACCESS_TOKEN để trống thì dùng FB_PAGE_TOKEN (Page token cần thêm instagram_basic,
# instagram_content_publish). IG_USER_ID + IG_PROFILE do nút "Kiểm tra Instagram" ở /profile tự ghi.
# Zernio: profile Zernio để gắn tài khoản mới (mặc định: profile Default)
# ZERNIO_PROFILE_ID=

# Đăng tự động (worker/autopublish.ts, cấu hình data/autopublish.json). Chỉ các profile liệt kê ở đây mới được ĐĂNG THẬT
# bởi scheduler (bỏ qua PUBLISH_DRY_RUN cho riêng các khung tự động). Để trống = scheduler chỉ dry-run.
AUTOPUBLISH_LIVE_PROFILES=
# CONTENT_PLAN_FILE=/path/to/06-content-plan.md   # mặc định lấy planFile trong data/autopublish.json

# Quanlop image2 (API ảnh riêng): POST https://image2.quanlop.vn/v1/images {prompt, aspect_ratio} -> PNG 768x1376 (9:16).
# Chưa nhận ảnh ref (body tối đa ~16 KB) nên chỉ dùng prompt. Lỗi thì tự chuyển sang Gemini (IMAGE_FALLBACK).
QUANLOP_IMAGE_API_KEY=
# QUANLOP_IMAGE_BASE_URL=https://image2.quanlop.vn
# Quá tải (429 capacity_exceeded, 5xx, rớt kết nối): thử lại tối đa QUANLOP_RETRIES lần, chờ Retry-After hoặc 10/20/40/60 giây.
# Hết lượt thử và không có dự phòng thì render dừng với lỗi (không xuất video có cảnh nền placeholder).
# QUANLOP_RETRIES=6
# QUANLOP_RETRY_MAX_WAIT=60
# Dự phòng khi provider chính lỗi, VD IMAGE_FALLBACK=quanlop (mặc định: quanlop -> gemini; còn lại không). "none" = tắt.
# IMAGE_FALLBACK=

# ===== Cấu hình theo kênh (lib/channel-config.ts) =====
# Slug kênh chỉ đặt ở đây (file env trên máy chủ), không viết cứng trong code.
# Profile chạy luồng biên tập có nguồn (duyệt số liệu -> MOW/Legal -> render -> tối đa 2 khung 07:00/11:30 mỗi ngày). Trống = tắt.
EDITORIAL_PROFILE=
# Hướng dẫn thêm khi AI sinh ý tưởng cho profile biên tập, VD "Luân phiên các tuyến A, B, C."
EDITORIAL_IDEA_GUIDE=
# Profile (phân tách dấu phẩy) bắt buộc dùng khoá Zernio riêng ZERNIO_API_KEY_<SLUG>, không bao giờ rơi về ZERNIO_API_KEY
ZERNIO_DEDICATED_PROFILES=
# Profile được tự đăng thật (docker-compose.autopublish.yml), phân tách dấu phẩy
AUTOPUBLISH_LIVE_PROFILES=
# Tag image cho docker-compose.tunnel.yml / autopublish.yml
APP_IMAGE=video-studio:latest
# Trang công khai /, /privacy, /terms (Google OAuth cần trang chủ và chính sách xem được khi chưa đăng nhập)
SITE_OWNER=
SITE_CHANNEL=
SITE_FB_PAGE=
SITE_VIDEO_KIND_VI=video ngắn
SITE_VIDEO_KIND_EN=short videos
